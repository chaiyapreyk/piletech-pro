generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  location        String?
  clientName      String?
  consultantName  String?
  contractorName  String?
  settings        ProjectSettings?
  piles           Pile[]
  criteria        DrivingCriteria[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProjectSettings {
  id                     String   @id @default(cuid())
  projectId              String   @unique
  project                Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  defaultSafetyFactor    Float    @default(2.5)
  maxPlumbnessPercent    Float    @default(1.0)
  devNormalThresholdCm   Float    @default(5.0)
  devCriticalThresholdCm Float    @default(10.0)
}

model DrivingCriteria {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String?  // Calculation sheet name, e.g. "I-0.26m อาคาร A (35 ตัน)"
  pileType            String   // e.g. "Prestressed Concrete I-0.26m"
  sectionId           String?  // Standard section ID e.g. "I_026", "SQ_035"
  safeWorkingLoadT    Float    // Ra in tons
  safetyFactor        Float    @default(2.5)
  hammerWeightT       Float    // W in tons
  dropHeightCm        Float    // H in cm
  pileWeightT         Float?   // P in tons
  cushionCoeffE       Float    @default(0.25)
  tempCompressionC    Float    // C in cm
  concreteStrengthKsc Float?   // fc' in ksc (e.g. 350)
  elasticModulusKsc   Float?   // Ec in ksc (e.g. 280,000)
  pileSectionAreaCm2  Float?   // Area A in cm2 (e.g. 484)
  pileLengthM         Float?   // L in meters (e.g. 20.0)
  hammerEfficiency    Float?   // Hammer efficiency eta
  targetSet10BlowsCm  Float    // Target S10 in cm
  notes               String?
  piles               Pile[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Pile {
  id            String           @id @default(cuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  criteriaId    String?
  criteria      DrivingCriteria? @relation(fields: [criteriaId], references: [id])
  pileNo        String           // e.g. "P-001"
  gridLine      String           // e.g. "A-1"
  building      String?          @default("Building A") // e.g. "Building A", "Building B", "Tower 1"
  status        String           @default("PLANNED") // PLANNED, DRIVING, COMPLETED, ISSUE
  castDate      DateTime?
  driveDate     DateTime?
  drivingRecord DrivingRecord?
  qcInspection  QCInspection?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model DrivingRecord {
  id                String   @id @default(cuid())
  pileId            String   @unique
  pile              Pile     @relation(fields: [pileId], references: [id], onDelete: Cascade)
  penetrationBlows  String   // JSON string of blow counts e.g. "[15, 20, 25]"
  recordUnit        String   @default("FEET") // "METER" or "FEET"
  recordScope       String   @default("FULL") // "FULL" or "LAST_N"
  windowLengthFt    Float?   // e.g. 20 (for last 20 ft)
  measuredLast10Cm  Float    // Measured set for last 10 blows in cm
  measuredTempCCm   Float?   // Measured C in cm
  drivenLengthM     Float    // Total driven length in meters
  totalPileLengthM  Float?   // Total specified/supplied pile length in meters
  stickUpLengthM    Float?   // Pile head stick-up above ground level in meters (negative if driven below ground with dolly)
  cutOffLevelM      Float?   // Cut-off elevation
  groundLevelM      Float?   // Ground surface elevation
  tipLevelM         Float?   // Pile tip elevation
  isSetPassed       Boolean  // True if measured <= target
  inspectorName     String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model QCInspection {
  id                String   @id @default(cuid())
  pileId            String   @unique
  pile              Pile     @relation(fields: [pileId], references: [id], onDelete: Cascade)
  plumbnessXPercent Float?
  plumbnessYPercent Float?
  isPlumbnessPassed Boolean  @default(true)
  designCoordX      Float?
  designCoordY      Float?
  actualCoordX      Float?
  actualCoordY      Float?
  deltaXCm          Float?
  deltaYCm          Float?
  netDeviationCm    Float?
  deviationStatus   String   @default("NORMAL") // NORMAL, WARNING, CRITICAL
  jointWeldStatus   String   @default("PASS")   // PASS, FAIL, NOT_APPLICABLE
  headDamageStatus  String   @default("NONE")   // NONE, MINOR, SEVERE
  photoUrls         String?  // JSON array of photo URLs
  inspectorName     String?
  approvedByCM      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
